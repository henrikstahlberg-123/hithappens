---
import { getCollection } from 'astro:content';
import { HARDNESS, getModels } from '../lib/models';

interface Props {
  categoryKey: string;
  initialSlug?: string;
}

const { categoryKey, initialSlug } = Astro.props;
const [siteEntry] = await getCollection('settings');
const engravingPrice = siteEntry.data.engravingPriceSek;
const inSeriesOrder = await getModels(categoryKey);
// Models with photos lead the wall; series order is kept within each group
const models = [...inSeriesOrder].sort((a, b) => Number(!a.images[0]) - Number(!b.images[0]));

const seriesList: { name: string; color: string; count: number }[] = [];
for (const m of inSeriesOrder) {
  const s = seriesList.find(x => x.name === m.seriesName);
  if (s) s.count++;
  else seriesList.push({ name: m.seriesName, color: m.seriesColor, count: 1 });
}
const hardnessPresent = HARDNESS.filter(h => models.some(m => m.hardness === h));
const level = (h: string) => HARDNESS.indexOf(h as (typeof HARDNESS)[number]);
const sek = (n: number) => `${n.toLocaleString('sv-SE')} SEK`;
---

<div class="mg" data-category-path={`/kollektioner/${categoryKey}`} data-initial={initialSlug ?? ''} data-eng-price={engravingPrice}>
  <div class="mg-filters">
    <div class="mg-filter-inner">
      <div class="mg-row" role="group" aria-label="Filtrera på serie">
        <button type="button" class="mg-chip is-on" data-series="" aria-pressed="true">Alla <span>{models.length}</span></button>
        {seriesList.map(s => (
          <button type="button" class="mg-chip" data-series={s.name} aria-pressed="false">
            <i style={`background:${s.color}`}></i>{s.name} <span>{s.count}</span>
          </button>
        ))}
      </div>
      {hardnessPresent.length > 1 && (
        <div class="mg-row" role="group" aria-label="Filtrera på hårdhet">
          <button type="button" class="mg-chip mg-chip--sm is-on" data-hardness="" aria-pressed="true">Alla hårdheter</button>
          {hardnessPresent.map(h => (
            <button type="button" class="mg-chip mg-chip--sm" data-hardness={h} aria-pressed="false">{h}</button>
          ))}
        </div>
      )}
    </div>
  </div>

  <div class="mg-body">
    <div class="mg-grid">
      {models.map((m, i) => (
        <a href={`/modell/${m.slug}`} class="mg-tile" data-slug={m.slug} data-series={m.seriesName} data-hardness={m.hardness} style={`--sc:${m.seriesColor}`}>
          <div class="mg-img">
            {m.images[0]
              ? <img src={m.images[0]} alt={m.name} loading={i < 6 ? 'eager' : 'lazy'} />
              : <div class="mg-ph"><span>{m.seriesName}</span></div>}
          </div>
          <div class="mg-meta">
            <span class="mg-series"><i></i>{m.seriesName} · {m.hardness}</span>
            <span class="mg-name">{m.name}</span>
            <span class="mg-price">{sek(m.priceSek)}</span>
          </div>
        </a>
      ))}
    </div>
    <p class="mg-empty" hidden>Inga modeller matchar filtret. <button type="button" data-reset>Visa alla</button></p>
  </div>

  <div class="mv" role="dialog" aria-modal="true" aria-label="Modellvisning" hidden>
    <div class="mv-progress"><i data-bar></i></div>
    <div class="mv-top">
      <button type="button" class="mv-close" data-close aria-label="Stäng">×</button>
      <span class="mv-pos"><span data-idx>1</span> / <span data-total>{models.length}</span></span>
    </div>

    <div class="mv-track" data-track>
      {models.map(m => (
        <article class="mv-slide" data-slug={m.slug} data-series={m.seriesName} data-hardness={m.hardness} data-name={m.name} style={`--sc:${m.seriesColor}`}>
          <div class="mv-media">
            {m.images[0]
              ? <img src={m.images[0]} alt={m.name} loading="lazy" />
              : <div class="mg-ph"><span>{m.name}</span></div>}
          </div>
          <div class="mv-info">
            <span class="mv-kicker"><i></i>{m.seriesName}{m.code && ` · ${m.code}`}</span>
            <h2 class="mv-name">{m.name}</h2>
            <p class="mv-desc">{m.descSv}</p>

            <div class="mv-hard" aria-label={`Hårdhet: ${m.hardness}`}>
              <div class="mv-hard-bar">{HARDNESS.map((_, j) => <i class={j <= level(m.hardness) ? 'f' : ''}></i>)}</div>
              <div class="mv-hard-l"><span>Mjuk</span><b>{m.hardness}</b><span>Hård</span></div>
            </div>

            <div class="mv-specs">
              <div><span>Längd</span>{m.length}</div>
              <div><span>Huvud Ø</span>{m.diam}</div>
              <div><span>Skaft Ø</span>{m.shaftDiam}</div>
              <div><span>Material</span>{m.material}</div>
            </div>

            <div class="mv-buy">
              <div>
                <div class="mv-price" data-base={m.priceSek}>{sek(m.priceSek)}</div>
                <div class="mv-unit">/ par · inkl moms</div>
              </div>
              <span class="mv-status"><i class={m.status === 'instock' ? 'in' : ''}></i>{m.status === 'instock' ? 'I lager' : 'Beställningsvara'}</span>
            </div>

            <div class="eng">
              <label class="eng-toggle">
                <input type="checkbox" data-eng-toggle />
                <span class="eng-box" aria-hidden="true"></span>
                <span class="eng-label">Personlig gravyr<small>Egen text bredvid och under loggan</small></span>
                <span class="eng-price">+{engravingPrice} SEK</span>
              </label>
              <div class="eng-fields" hidden>
                <div class="eng-shaft" aria-hidden="true">
                  <div class="eng-logo">
                    <span class="eng-mark"><svg viewBox="-6 -6 298 314"><polygon points="45,0 285,150 45,302 0,272 170,150 0,30" stroke-width="10" stroke-linejoin="round"/></svg>Hit Happens</span>
                    <span class="eng-under" data-eng-under-out></span>
                  </div>
                  <span class="eng-right" data-eng-right-out></span>
                </div>
                <div class="eng-row">
                  <label for={`eng-right-${m.slug}`}>Text till höger om loggan</label>
                  <input id={`eng-right-${m.slug}`} data-eng-right maxlength="32" placeholder="T.ex. Ankeborg Philharmonic" />
                </div>
                <div class="eng-row">
                  <label for={`eng-under-${m.slug}`}>Text under loggan</label>
                  <input id={`eng-under-${m.slug}`} data-eng-under maxlength="20" placeholder="T.ex. Mickey Mouse" />
                </div>
              </div>
            </div>

            <button
              type="button"
              class="btn mv-add"
              data-add-cart
              data-key={`${m.seriesName}||${m.name}`}
              data-series={m.seriesName}
              data-model={m.name}
              data-price={m.priceSek}
              data-color={m.seriesColor}
              data-image={m.images[0] || ''}
            >Lägg i varukorg →</button>

            <button type="button" class="mv-next" data-next>
              <span>Nästa modell</span><b data-next-name></b><span aria-hidden="true">→</span>
            </button>
          </div>
        </article>
      ))}
    </div>

    <button type="button" class="mv-arrow mv-arrow--prev" data-go="-1" aria-label="Föregående modell">←</button>
    <button type="button" class="mv-arrow mv-arrow--next" data-go="1" aria-label="Nästa modell">→</button>
  </div>
</div>

<style>
  .mg-tile[hidden], .mv-slide[hidden], .mg-empty[hidden], .mv[hidden], .mv-next[hidden] { display: none !important }

  /* ── Sticky filters ── */
  .mg-filters {
    position: sticky; top: var(--nav-h); z-index: 100;
    background: rgba(11,19,28,0.9); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border-block: 1px solid var(--border2);
  }
  .mg-filter-inner { max-width: var(--max); margin: 0 auto; padding: 0.7rem 1.75rem; display: flex; flex-direction: column; gap: 0.5rem }
  .mg-row { display: flex; gap: 0.45rem; overflow-x: auto; scrollbar-width: none; margin-inline: -1.75rem; padding-inline: 1.75rem }
  .mg-row::-webkit-scrollbar { display: none }
  .mg-chip {
    flex-shrink: 0; display: inline-flex; align-items: center; gap: 0.45rem;
    padding: 0.5rem 0.95rem; border-radius: 100px; cursor: pointer; white-space: nowrap;
    border: 1px solid var(--border2); background: rgba(242,233,216,0.04); color: var(--cream2);
    font: 500 0.8rem var(--font-sans); transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .mg-chip i { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0 }
  .mg-chip span { color: var(--text3); font-size: 0.72rem }
  .mg-chip:hover { border-color: rgba(242,233,216,0.25) }
  .mg-chip.is-on { background: var(--cream); color: var(--dark); border-color: var(--cream) }
  .mg-chip.is-on span { color: rgba(11,19,28,0.55) }
  .mg-chip--sm { padding: 0.35rem 0.8rem; font-size: 0.74rem }
  .mg-chip:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px }

  /* ── Gallery wall ── */
  .mg-body { max-width: var(--max); margin: 0 auto; padding: 1.4rem 1.75rem 2.5rem }
  .mg-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.6rem 0.9rem }
  .mg-tile { display: flex; flex-direction: column; gap: 0.75rem; text-decoration: none; color: inherit; min-width: 0 }
  .mg-img {
    position: relative; aspect-ratio: 4 / 5; border-radius: var(--r-sm); overflow: hidden;
    background: var(--dark3); box-shadow: 0 1px 0 rgba(255,250,240,0.08) inset, 0 12px 32px rgba(0,0,0,0.4);
  }
  .mg-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.7s var(--ease) }
  .mg-tile:hover .mg-img img { transform: scale(1.045) }
  .mg-tile:focus-visible .mg-img { outline: 2px solid var(--blue); outline-offset: 3px }
  .mg-ph {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; padding: 1rem; text-align: center;
    background: var(--dark3);
    background: radial-gradient(140% 110% at 25% 10%, color-mix(in srgb, var(--sc) 70%, var(--dark3)) 0%, color-mix(in srgb, var(--sc) 22%, var(--dark2)) 100%);
  }
  .mg-tile .mg-ph span { text-transform: uppercase; letter-spacing: 0.04em; opacity: 0.85 }
  .mg-ph span { font-family: var(--font-display); font-weight: 800; letter-spacing: -0.02em; font-size: clamp(1.15rem, 3.6vw, 1.7rem); line-height: 1.1; color: var(--cream) }
  .mg-meta { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0 }
  .mg-series { display: flex; align-items: center; gap: 0.4rem; font-size: 0.6rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text3); font-weight: 600 }
  .mg-series i { width: 6px; height: 6px; border-radius: 50%; background: var(--sc); flex-shrink: 0 }
  .mg-name { font-family: var(--font-display); font-weight: 800; font-size: 1.15rem; color: var(--cream); line-height: 1.15 }
  .mg-price { font-size: 0.82rem; color: var(--text2) }
  .mg-empty { color: var(--text2); padding: 3rem 0; text-align: center }
  .mg-empty button { background: none; border: 0; color: var(--blue); cursor: pointer; font: inherit; text-decoration: underline }

  @media (min-width: 640px) { .mg-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.2rem 1.3rem } }
  @media (min-width: 1000px) { .mg-grid { grid-template-columns: repeat(4, minmax(0, 1fr)) } }
  @media (max-width: 767px) {
    .mg-filter-inner, .mg-body { padding-inline: 1.25rem }
    .mg-row { margin-inline: -1.25rem; padding-inline: 1.25rem }
  }

  /* ── Full-screen viewer ── */
  .mv { position: fixed; inset: 0; z-index: 350; background: var(--dark); display: flex; flex-direction: column }
  .mv-progress { position: absolute; top: 0; left: 0; right: 0; height: 3px; z-index: 4; background: rgba(242,233,216,0.1) }
  .mv-progress i { display: block; height: 100%; width: 0; background: var(--cream); transition: width 0.35s var(--ease) }
  .mv-top {
    position: absolute; top: 0; left: 0; right: 0; z-index: 3; pointer-events: none;
    display: flex; align-items: center; justify-content: space-between;
    padding: calc(env(safe-area-inset-top, 0px) + 0.9rem) 1rem 0.9rem;
  }
  .mv-top > * { pointer-events: auto }
  .mv-close, .mv-pos, .mv-arrow {
    background: rgba(11,19,28,0.78); border: 1px solid rgba(242,233,216,0.16); color: var(--cream);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  }
  .mv-close { width: 44px; height: 44px; border-radius: 50%; font-size: 1.5rem; line-height: 1; cursor: pointer }
  .mv-pos { padding: 0.5rem 0.95rem; border-radius: 100px; font-size: 0.76rem; letter-spacing: 0.08em; font-variant-numeric: tabular-nums }
  .mv-track {
    position: relative; flex: 1; display: flex; overflow-x: auto; overflow-y: hidden;
    scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior: contain;
  }
  .mv-track::-webkit-scrollbar { display: none }
  .mv-slide { flex: 0 0 100%; height: 100%; overflow-y: auto; scroll-snap-align: start; scroll-snap-stop: always; display: flex; flex-direction: column }
  .mv-media { position: relative; height: 54svh; flex-shrink: 0; background: var(--dark3); overflow: hidden }
  .mv-media img { width: 100%; height: 100%; object-fit: cover; display: block }
  .mv-media .mg-ph span { font-size: clamp(2rem, 9vw, 3.4rem) }
  .mv-info { display: flex; flex-direction: column; gap: 1.1rem; padding: 1.5rem 1.25rem calc(env(safe-area-inset-bottom, 0px) + 2.2rem); width: 100%; max-width: 560px }
  .mv-kicker { display: flex; align-items: center; gap: 0.5rem; font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text2); font-weight: 600 }
  .mv-kicker i { width: 8px; height: 8px; border-radius: 50%; background: var(--sc) }
  .mv-name { font-family: var(--font-display); font-size: clamp(2.2rem, 8vw, 3.4rem); font-weight: 800; line-height: 1.02; color: var(--cream); letter-spacing: -0.025em; margin-top: -0.4rem }
  .mv-desc { color: var(--text2); line-height: 1.7; font-weight: 300; font-size: 0.98rem }
  .mv-hard-bar { display: grid; grid-template-columns: repeat(5, 1fr); gap: 4px }
  .mv-hard-bar i { height: 6px; border-radius: 3px; background: rgba(242,233,216,0.1) }
  .mv-hard-bar i.f { background: var(--sc) }
  .mv-hard-l { display: flex; justify-content: space-between; margin-top: 0.45rem; font-size: 0.64rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text3) }
  .mv-hard-l b { color: var(--cream); font-weight: 600 }
  .mv-specs { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem }
  .mv-specs div { background: rgba(242,233,216,0.04); border: 1px solid var(--border2); border-radius: var(--r-sm); padding: 0.6rem 0.8rem; font-size: 0.88rem; color: var(--cream2); font-weight: 500 }
  .mv-specs span { display: block; font-size: 0.58rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text3); margin-bottom: 0.15rem; font-weight: 600 }
  .mv-buy { display: flex; align-items: center; justify-content: space-between; padding-top: 1.1rem; border-top: 1px solid var(--border2) }
  .mv-price { font-family: var(--font-display); font-weight: 700; font-size: 1.7rem; color: var(--cream); line-height: 1 }
  .mv-unit { font-size: 0.66rem; color: var(--text3); text-transform: uppercase; letter-spacing: 0.06em; margin-top: 4px }
  .mv-status { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.76rem; color: var(--text2); font-weight: 500 }
  .mv-status i { width: 8px; height: 8px; border-radius: 50%; background: var(--warm2) }
  .mv-status i.in { background: #4ade80 }
  .mv-add { width: 100%; justify-content: center }
  .mv-add:disabled { opacity: 0.55; cursor: not-allowed; transform: none }

  /* ── Engraving ── */
  .eng { border: 1px solid var(--border2); border-radius: var(--r-sm); background: rgba(242,233,216,0.03) }
  .eng-toggle { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0.8rem; padding: 0.85rem 1rem; cursor: pointer }
  .eng-toggle input { position: absolute; opacity: 0; pointer-events: none }
  .eng-box { width: 20px; height: 20px; border-radius: 6px; border: 1.5px solid rgba(242,233,216,0.35); display: grid; place-items: center; transition: background 0.2s, border-color 0.2s }
  .eng-toggle input:checked + .eng-box { background: var(--cream); border-color: var(--cream) }
  .eng-toggle input:checked + .eng-box::after { content: '✓'; color: var(--dark); font-size: 0.8rem; font-weight: 800 }
  .eng-toggle input:focus-visible + .eng-box { outline: 2px solid var(--blue); outline-offset: 2px }
  .eng-label { font-family: var(--font-display); font-weight: 800; font-size: 0.95rem; color: var(--cream); letter-spacing: -0.01em }
  .eng-label small { display: block; font-family: var(--font-sans); font-weight: 400; font-size: 0.78rem; color: var(--text3); letter-spacing: 0; margin-top: 1px }
  .eng-price { font-family: var(--font-display); font-weight: 700; font-size: 0.85rem; color: var(--cream); white-space: nowrap }
  .eng-fields { padding: 0 1rem 1rem; display: flex; flex-direction: column; gap: 0.7rem }
  /* Mirrors the real laser engraving: logo always, custom text to its right and beneath it */
  .eng-shaft {
    --burn: #1c1007;
    container-type: inline-size;
    display: flex; align-items: flex-start; gap: clamp(0.6rem, 4cqi, 1.2rem); min-height: 62px; padding: 0.85rem 1rem 0.7rem; border-radius: 31px; overflow: hidden;
    background:
      repeating-linear-gradient(176deg, rgba(120,70,30,0.07) 0 1px, transparent 1px 7px),
      linear-gradient(180deg, #f0d2a4 0%, #e2b880 50%, #c99659 100%);
    box-shadow: inset 0 -4px 8px rgba(90,50,20,0.25), inset 0 2px 3px rgba(255,245,225,0.5);
    color: var(--burn); text-shadow: 0 0 1px rgba(42,26,12,0.3);
  }
  .eng-logo { flex-shrink: 0; display: flex; flex-direction: column; align-items: center; gap: 0.15rem }
  .eng-mark { display: inline-flex; align-items: center; gap: 0.3rem; font-family: var(--font-display); font-weight: 800; font-size: clamp(0.8rem, 4.8cqi, 1rem); letter-spacing: -0.01em; text-transform: uppercase; white-space: nowrap }
  .eng-mark svg { height: 0.95em; width: auto }
  .eng-mark polygon { fill: var(--burn); stroke: var(--burn) }
  .eng-under { font-family: var(--font-sans); font-weight: 600; font-size: clamp(0.68rem, 3.6cqi, 0.8rem); white-space: nowrap; min-height: 1em }
  .eng-right {
    font-family: var(--font-sans); font-weight: 600; font-size: clamp(0.76rem, 4.4cqi, 0.95rem); line-height: 1.25; padding-top: 0.05rem; min-width: 0;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .eng-right.is-empty, .eng-under.is-empty { opacity: 0.6 }
  .eng-row label { display: block; font-size: 0.62rem; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600; color: var(--text2); margin-bottom: 0.35rem }
  .eng-row label span { text-transform: none; letter-spacing: 0; color: var(--text3); font-weight: 400 }
  .eng-row input {
    width: 100%; padding: 0.7rem 0.85rem; background: rgba(11,19,28,0.6); border: 1px solid var(--border2); border-radius: var(--r-sm);
    color: var(--cream); font: 400 0.95rem var(--font-sans);
  }
  .eng-row input:focus { outline: none; border-color: rgba(74,158,255,0.6); box-shadow: 0 0 0 3px rgba(74,158,255,0.12) }
  .mv-next {
    display: grid; grid-template-columns: auto 1fr auto; align-items: baseline; gap: 0.8rem; text-align: left;
    background: none; border: 1px solid var(--border2); border-radius: var(--r-sm); padding: 0.95rem 1rem; cursor: pointer;
    color: var(--text3); font: 600 0.62rem var(--font-sans); letter-spacing: 0.14em; text-transform: uppercase;
    transition: border-color 0.2s, background 0.2s;
  }
  .mv-next b { font-family: var(--font-display); font-size: 1.1rem; font-weight: 700; letter-spacing: 0; text-transform: none; color: var(--cream); overflow: hidden; text-overflow: ellipsis; white-space: nowrap }
  .mv-next span:last-child { font-size: 1rem; color: var(--cream) }
  .mv-next:hover { border-color: rgba(242,233,216,0.3); background: rgba(242,233,216,0.04) }
  .mv-arrow { display: none }

  @media (min-width: 900px) {
    .mv-slide { flex-direction: row; overflow: hidden }
    .mv-media { height: 100%; flex: 1.3 }
    .mv-info { flex: 1; max-width: none; justify-content: center; overflow-y: auto; padding: 5rem clamp(2rem, 5vw, 5rem) 3rem }
    .mv-info > * { max-width: 460px }
    .mv-arrow {
      display: flex; align-items: center; justify-content: center; position: absolute; top: 50%; z-index: 3;
      width: 54px; height: 54px; margin-top: -27px; border-radius: 50%; font-size: 1.2rem; cursor: pointer;
      transition: background 0.2s, opacity 0.2s;
    }
    .mv-arrow:hover { background: rgba(26,44,64,0.9) }
    .mv-arrow:disabled { opacity: 0.25; cursor: default }
    .mv-arrow--prev { left: 1.2rem }
    .mv-arrow--next { right: 1.2rem }
  }
  @media (prefers-reduced-motion: reduce) { .mg-img img, .mv-progress i { transition: none } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.mg');
  if (root) {
    const tiles = [...root.querySelectorAll<HTMLAnchorElement>('.mg-tile')];
    const slides = [...root.querySelectorAll<HTMLElement>('.mv-slide')];
    const viewer = root.querySelector<HTMLElement>('.mv')!;
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const idxEl = root.querySelector<HTMLElement>('[data-idx]')!;
    const totalEl = root.querySelector<HTMLElement>('[data-total]')!;
    const bar = root.querySelector<HTMLElement>('[data-bar]')!;
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-go="-1"]')!;
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-go="1"]')!;
    const categoryPath = root.dataset.categoryPath!;
    const baseTitle = document.title;

    let series = '';
    let hardness = '';
    let current: HTMLElement | null = null;
    let pushed = false;
    let lastTile: HTMLElement | null = null;

    const matches = (el: HTMLElement) => (!series || el.dataset.series === series) && (!hardness || el.dataset.hardness === hardness);
    const visibleSlides = () => slides.filter(s => !s.hidden);

    function applyFilter() {
      let n = 0;
      tiles.forEach(t => { t.hidden = !matches(t); if (!t.hidden) n++; });
      slides.forEach(s => { s.hidden = !matches(s); });
      root!.querySelector<HTMLElement>('.mg-empty')!.hidden = n > 0;
      root!.querySelectorAll<HTMLElement>('[data-series].mg-chip').forEach(c => setChip(c, c.dataset.series === series));
      root!.querySelectorAll<HTMLElement>('[data-hardness].mg-chip').forEach(c => setChip(c, c.dataset.hardness === hardness));
      const v = visibleSlides();
      v.forEach((s, i) => {
        const btn = s.querySelector<HTMLElement>('[data-next]')!;
        const next = v[i + 1];
        btn.hidden = !next;
        if (next) btn.querySelector('[data-next-name]')!.textContent = next.dataset.name || '';
      });
    }
    function setChip(c: HTMLElement, on: boolean) {
      c.classList.toggle('is-on', on);
      c.setAttribute('aria-pressed', String(on));
    }

    root.querySelectorAll<HTMLElement>('.mg-chip').forEach(c => c.addEventListener('click', () => {
      if (c.dataset.series !== undefined) series = c.dataset.series;
      if (c.dataset.hardness !== undefined) hardness = c.dataset.hardness;
      applyFilter();
    }));
    root.querySelector('[data-reset]')?.addEventListener('click', () => { series = ''; hardness = ''; applyFilter(); });

    function setCurrent(slide: HTMLElement) {
      current = slide;
      const v = visibleSlides();
      const i = v.indexOf(slide);
      idxEl.textContent = String(i + 1);
      totalEl.textContent = String(v.length);
      bar.style.width = `${((i + 1) / v.length) * 100}%`;
      prevBtn.disabled = i <= 0;
      nextBtn.disabled = i >= v.length - 1;
      document.title = `${slide.dataset.name} – Hit Happens`;
      history.replaceState({ mv: slide.dataset.slug }, '', `/modell/${slide.dataset.slug}`);
    }

    function open(slug: string, push: boolean) {
      const target = slides.find(s => s.dataset.slug === slug);
      if (!target) return;
      if (target.hidden) { series = ''; hardness = ''; applyFilter(); }
      viewer.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      if (push) { history.pushState({ mv: slug }, '', `/modell/${slug}`); pushed = true; }
      track.scrollLeft = target.offsetLeft;
      target.scrollTop = 0;
      setCurrent(target);
      viewer.querySelector<HTMLElement>('[data-close]')!.focus({ preventScroll: true });
    }

    function close(fromPopstate = false) {
      if (viewer.hidden) return;
      viewer.hidden = true;
      document.documentElement.style.overflow = '';
      document.title = baseTitle;
      const tile = current && tiles.find(t => t.dataset.slug === current!.dataset.slug);
      if (!fromPopstate) {
        if (pushed) history.back();
        else history.replaceState(null, '', categoryPath);
      }
      pushed = false;
      (tile || lastTile)?.scrollIntoView({ block: 'center' });
      (tile || lastTile)?.focus({ preventScroll: true });
    }

    function go(delta: number) {
      const v = visibleSlides();
      const target = current && v[v.indexOf(current) + delta];
      if (target) track.scrollTo({ left: target.offsetLeft, behavior: 'smooth' });
    }

    tiles.forEach(t => t.addEventListener('click', e => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      e.preventDefault();
      lastTile = t;
      open(t.dataset.slug!, true);
    }));

    const io = new IntersectionObserver(entries => {
      if (viewer.hidden) return;
      entries.forEach(e => { if (e.isIntersecting && e.target !== current) setCurrent(e.target as HTMLElement); });
    }, { root: track, threshold: 0.6 });
    slides.forEach(s => io.observe(s));
    // Fallback for views where IntersectionObserver is paused or late: settle on the slide nearest the scroll position
    let settle = 0;
    track.addEventListener('scroll', () => {
      clearTimeout(settle);
      settle = window.setTimeout(() => {
        if (viewer.hidden) return;
        const v = visibleSlides();
        const nearest = v.reduce((best, sl) => Math.abs(sl.offsetLeft - track.scrollLeft) < Math.abs(best.offsetLeft - track.scrollLeft) ? sl : best, v[0]);
        if (nearest && nearest !== current) setCurrent(nearest);
      }, 90);
    }, { passive: true });

    viewer.querySelector('[data-close]')!.addEventListener('click', () => close());
    prevBtn.addEventListener('click', () => go(-1));
    nextBtn.addEventListener('click', () => go(1));
    root.querySelectorAll('[data-next]').forEach(b => b.addEventListener('click', () => go(1)));

    document.addEventListener('keydown', e => {
      if (viewer.hidden) return;
      if (document.querySelector('.cart-overlay.open, .order-overlay.open')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowRight') go(1);
      if (e.key === 'ArrowLeft') go(-1);
    });

    window.addEventListener('popstate', e => {
      const slug = (e.state as { mv?: string } | null)?.mv;
      if (slug) open(slug, false);
      else close(true);
    });

    const engPrice = Number(root.dataset.engPrice || 0);
    const sekText = (n: number) => `${n.toLocaleString('sv-SE')} SEK`;
    slides.forEach(slide => {
      const toggle = slide.querySelector<HTMLInputElement>('[data-eng-toggle]')!;
      const fields = slide.querySelector<HTMLElement>('.eng-fields')!;
      const right = slide.querySelector<HTMLInputElement>('[data-eng-right]')!;
      const under = slide.querySelector<HTMLInputElement>('[data-eng-under]')!;
      const rightOut = slide.querySelector<HTMLElement>('[data-eng-right-out]')!;
      const underOut = slide.querySelector<HTMLElement>('[data-eng-under-out]')!;
      const preview = (el: HTMLElement, value: string, example: string) => {
        el.textContent = value || example;
        el.classList.toggle('is-empty', !value);
      };
      const add = slide.querySelector<HTMLButtonElement>('[data-add-cart]')!;
      const priceEl = slide.querySelector<HTMLElement>('.mv-price')!;
      const base = Number(priceEl.dataset.base);
      const sync = () => {
        const on = toggle.checked;
        const r = right.value.trim();
        const u = under.value.trim();
        const text = [r && `Höger: "${r}"`, u && `Under: "${u}"`].filter(Boolean).join(' · ');
        const engraving = on ? text : '';
        const price = base + (on ? engPrice : 0);
        fields.hidden = !on;
        preview(rightOut, r, 'Ankeborg Philharmonic');
        preview(underOut, u, 'Mickey Mouse');
        priceEl.textContent = sekText(price);
        add.dataset.engraving = engraving;
        add.dataset.price = String(price);
        add.dataset.key = `${add.dataset.series}||${add.dataset.model}${engraving ? `||${engraving}` : ''}`;
        add.disabled = on && !text;
        add.textContent = add.disabled ? 'Skriv text för gravyren' : 'Lägg i varukorg →';
      };
      toggle.addEventListener('change', () => { sync(); if (toggle.checked) right.focus({ preventScroll: true }); });
      right.addEventListener('input', sync);
      under.addEventListener('input', sync);
      sync();
    });

    applyFilter();
    if (root.dataset.initial) open(root.dataset.initial, false);
  }
</script>
