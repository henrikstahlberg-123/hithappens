---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allServices = await getCollection('rehabServices');
const services = allServices.sort((a, b) => a.data.order - b.data.order);

---

<Layout title="Rehab" vibe="amber">
  <div class="page-hero" style="min-height:auto;padding-bottom:1.5rem">
    <div class="page-hero-inner">
      <p class="page-kicker">Rehab</p>
      <h1>Ge dina stockar<br><em>nytt liv</em></h1>
      <p>Alla märken och modeller. Inte nöjd? Då gör vi om. Leveranstid ca 1–2 veckor.</p>
    </div>
  </div>

  <main>
    <section class="section" style="padding-top:1rem;padding-bottom:2rem">
      <div class="section-inner">
        <div class="svc-grid">
          {services.map(svc => (
            <div class="glass glass-grad lit reveal svc-card">
              <div class="svc-head">
                <h3 class="svc-name">{svc.data.nameSv}</h3>
                <div class="svc-price">{svc.data.priceSek} SEK<span>/ par · inkl moms</span></div>
              </div>
              {(svc.data.imageBefore || svc.data.imageDuring || svc.data.imageAfter) && <div class="svc-before-after">
                <div class:list={["svc-photo", { "svc-photo--empty": !svc.data.imageBefore }]}>
                  <span class="svc-photo-label">Före</span>
                  {svc.data.imageBefore
                  ? <img src={svc.data.imageBefore} alt={`${svc.data.nameSv} — före`} loading="lazy" />
                  : <span class="svc-photo-ph"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>Foto snart</span>}
                </div>
                <div class:list={["svc-photo", { "svc-photo--empty": !svc.data.imageDuring }]}>
                  <span class="svc-photo-label">Rehab</span>
                  {svc.data.imageDuring
                    ? <img src={svc.data.imageDuring} alt={`${svc.data.nameSv} — rehab`} loading="lazy" />
                    : <span class="svc-photo-ph"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>Foto snart</span>}
                </div>
                <div class:list={["svc-photo", { "svc-photo--empty": !svc.data.imageAfter }]}>
                  <span class="svc-photo-label">Efter</span>
                  {svc.data.imageAfter
                    ? <img src={svc.data.imageAfter} alt={`${svc.data.nameSv} — efter`} loading="lazy" />
                    : <span class="svc-photo-ph"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>Foto snart</span>}
                </div>
              </div>}
              <p class="svc-desc">{svc.data.descSv}</p>
              <div class="svc-included">
                {svc.data.includedSv.map(item => (
                  <div class="incl"><span class="warm">✓</span>{item}</div>
                ))}
              </div>
              <button type="button" class="btn" data-order data-series="Rehab" data-model={svc.data.nameSv} data-message="Antal par: " style="width:100%;justify-content:center;margin-top:auto">Boka {svc.data.nameSv} →</button>
            </div>
          ))}
        </div>

      </div>
    </section>
  </main>
</Layout>

<style>
  .warm { color: var(--warm2) }

  .svc-grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem }
  .svc-card { padding: 1.5rem; display: flex; flex-direction: column }
  .svc-head { display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 0.9rem }
  .svc-name { font-family: var(--font-display); font-size: 1.5rem; font-weight: 800; color: var(--cream) }
  .svc-price { font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; color: var(--cream); line-height: 1 }
  .svc-price span { font-family: var(--font-sans); font-size: 0.72rem; color: var(--text3); margin-left: 0.4rem; font-weight: 400 }
  .svc-desc { font-size: 0.88rem; color: var(--text2); line-height: 1.7; margin-bottom: 1.3rem; font-weight: 300 }
  .svc-included { display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 1.3rem }

  .svc-before-after { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.6rem; margin-bottom: 1.4rem }
  .svc-photo {
    position: relative; aspect-ratio: 4/3; border-radius: var(--r-sm); overflow: hidden;
    background: rgba(11,19,28,0.5); display: flex; align-items: center; justify-content: center;
  }
  .svc-photo img { width: 100%; height: 100%; object-fit: cover; display: block }
  .svc-photo-label {
    position: absolute; top: 8px; left: 8px; z-index: 1;
    font-size: 0.58rem; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 700;
    color: var(--cream); background: rgba(11,19,28,0.7); backdrop-filter: blur(4px);
    padding: 3px 10px; border-radius: 100px;
  }
  .svc-photo-ph {
    display: flex; flex-direction: column; align-items: center; gap: 0.4rem;
    font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text3);
    opacity: 0.55;
  }
  .svc-photo-ph svg { opacity: 0.5 }
  .svc-photo--empty {
    background: linear-gradient(135deg, rgba(255,184,102,0.06) 0%, rgba(11,19,28,0.55) 100%);
    border: 1px dashed rgba(255,184,102,0.18);
  }


  .incl { display: flex; align-items: center; gap: 0.7rem; font-size: 0.9rem; color: var(--text2) }


  @media (min-width: 760px) {
    .svc-grid { grid-template-columns: 1fr 1fr }
  }
</style>

