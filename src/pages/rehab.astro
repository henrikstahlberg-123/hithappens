---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allServices = await getCollection('rehabServices');
const services = allServices.sort((a, b) => a.data.order - b.data.order);

const formFields = [
  { id: 'r-name', name: 'name', label: 'Namn', type: 'text', placeholder: 'För- och efternamn', autocomplete: 'name' },
  { id: 'r-email', name: 'email', label: 'E-postadress', type: 'email', placeholder: 'din@email.se', autocomplete: 'email' },
];
---

<Layout title="Rehab" vibe="amber">
  <div class="page-hero" style="min-height:auto;padding-bottom:1.5rem">
    <div class="page-hero-inner">
      <p class="page-kicker">Rehab</p>
      <h1>Ge dina stockar<br><em>nytt liv</em></h1>
      <p>Alla märken och modeller. Inte nöjd? Då gör vi om. Leveranstid ca 1–2 veckor.</p>
    </div>
  </div>

  <main>
    <section class="section" style="padding-top:1rem;padding-bottom:2rem">
      <div class="section-inner">
        <div class="svc-grid">
          {services.map(svc => (
            <div class="glass glass-grad lit reveal svc-card">
              <div class="svc-head">
                <h3 class="svc-name">{svc.data.nameSv}</h3>
                <div class="svc-price">{svc.data.priceSek} SEK<span>/ par · inkl moms</span></div>
              </div>
              {(svc.data.imageBefore || svc.data.imageDuring || svc.data.imageAfter) && <div class="svc-before-after">
                <div class:list={["svc-photo", { "svc-photo--empty": !svc.data.imageBefore }]}>
                  <span class="svc-photo-label">Före</span>
                  {svc.data.imageBefore
                  ? <img src={svc.data.imageBefore} alt={`${svc.data.nameSv} — före`} loading="lazy" />
                  : <span class="svc-photo-ph"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>Foto snart</span>}
                </div>
                <div class:list={["svc-photo", { "svc-photo--empty": !svc.data.imageDuring }]}>
                  <span class="svc-photo-label">Rehab</span>
                  {svc.data.imageDuring
                    ? <img src={svc.data.imageDuring} alt={`${svc.data.nameSv} — rehab`} loading="lazy" />
                    : <span class="svc-photo-ph"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>Foto snart</span>}
                </div>
                <div class:list={["svc-photo", { "svc-photo--empty": !svc.data.imageAfter }]}>
                  <span class="svc-photo-label">Efter</span>
                  {svc.data.imageAfter
                    ? <img src={svc.data.imageAfter} alt={`${svc.data.nameSv} — efter`} loading="lazy" />
                    : <span class="svc-photo-ph"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>Foto snart</span>}
                </div>
              </div>}
              <p class="svc-desc">{svc.data.descSv}</p>
              <div class="svc-included">
                {svc.data.includedSv.map(item => (
                  <div class="incl"><span class="warm">✓</span>{item}</div>
                ))}
              </div>
              <button type="button" class="btn svc-book" data-service={svc.data.nameSv} style="width:100%;justify-content:center;margin-top:auto">Boka {svc.data.nameSv} →</button>
            </div>
          ))}
        </div>

      </div>
    </section>

    <section id="rehab-form" class="section book">
      <div class="section-inner glass glass-grad lit book-card">
        <h2 class="sec-title">Boka <em>rehab</em></h2>
        <p class="book-lead">Vi återkommer med adress och packningsinstruktioner.</p>
        <form id="rehab-form-el">
          <input type="hidden" name="_subject" value="Rehab-bokning" />
          {formFields.map(field => (
            <div class="rf-field">
              <label for={field.id}>{field.label}</label>
              <input type={field.type} id={field.id} name={field.name} placeholder={field.placeholder} autocomplete={field.autocomplete} required />
            </div>
          ))}
          <div class="rf-field">
            <label for="r-message">Vad vill du ha hjälp med?</label>
            <textarea id="r-message" name="message" rows="4" placeholder="T.ex. 2 par Pukstocks-rehab och 1 par Mallet-rehab" required></textarea>
          </div>
          <button type="submit" class="btn" id="rehabSubmit" style="width:100%;justify-content:center;margin-top:0.6rem">Boka Rehab →</button>
          <p class="order-err" id="rehabErr">Något gick fel. Försök igen eller mejla oss direkt.</p>
        </form>
        <div class="order-success" id="rehabSuccess">
          <div class="tick">✓</div>
          <h2>Tack!</h2>
          <p class="order-intro">Vi har tagit emot din bokning och återkommer med adress och packningsinstruktioner.</p>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .warm { color: var(--warm2) }

  .svc-grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem }
  .svc-card { padding: 1.5rem; display: flex; flex-direction: column }
  .svc-head { display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 0.9rem }
  .svc-name { font-family: var(--font-display); font-size: 1.5rem; font-weight: 800; color: var(--cream) }
  .svc-price { font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; color: var(--cream); line-height: 1 }
  .svc-price span { font-family: var(--font-sans); font-size: 0.72rem; color: var(--text3); margin-left: 0.4rem; font-weight: 400 }
  .svc-desc { font-size: 0.88rem; color: var(--text2); line-height: 1.7; margin-bottom: 1.3rem; font-weight: 300 }
  .svc-included { display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 1.3rem }

  .svc-before-after { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.6rem; margin-bottom: 1.4rem }
  .svc-photo {
    position: relative; aspect-ratio: 4/3; border-radius: var(--r-sm); overflow: hidden;
    background: rgba(11,19,28,0.5); display: flex; align-items: center; justify-content: center;
  }
  .svc-photo img { width: 100%; height: 100%; object-fit: cover; display: block }
  .svc-photo-label {
    position: absolute; top: 8px; left: 8px; z-index: 1;
    font-size: 0.58rem; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 700;
    color: var(--cream); background: rgba(11,19,28,0.7); backdrop-filter: blur(4px);
    padding: 3px 10px; border-radius: 100px;
  }
  .svc-photo-ph {
    display: flex; flex-direction: column; align-items: center; gap: 0.4rem;
    font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text3);
    opacity: 0.55;
  }
  .svc-photo-ph svg { opacity: 0.5 }
  .svc-photo--empty {
    background: linear-gradient(135deg, rgba(255,184,102,0.06) 0%, rgba(11,19,28,0.55) 100%);
    border: 1px dashed rgba(255,184,102,0.18);
  }


  .incl { display: flex; align-items: center; gap: 0.7rem; font-size: 0.9rem; color: var(--text2) }

  .rf-field { margin-bottom: 0.9rem }
  .rf-field label { display: block; font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600; color: var(--text2); margin-bottom: 0.4rem }
  .rf-field input, .rf-field textarea {
    width: 100%; padding: 0.75rem 0.9rem; background: rgba(11,19,28,0.6);
    border: 1px solid var(--border2); border-radius: var(--r-sm); color: var(--cream);
    font-family: var(--font-sans); font-size: 0.9rem; transition: border-color 0.2s, box-shadow 0.2s;
  }
  .rf-field textarea { resize: vertical; min-height: 84px }
  .rf-field input::placeholder, .rf-field textarea::placeholder { color: var(--text3) }
  .rf-field input:focus, .rf-field textarea:focus { outline: none; border-color: rgba(var(--page-rgb),0.6); box-shadow: 0 0 0 3px rgba(var(--page-rgb),0.12) }
  .book { padding-top: 1rem; scroll-margin-top: calc(var(--nav-h) + 0.5rem) }
  .book-card { max-width: 560px; padding: 1.75rem }
  .book-lead { color: var(--text2); font-size: 0.92rem; margin: 0.5rem 0 1.4rem }
  .btn[disabled] { opacity: 0.6; cursor: wait }

  @media (min-width: 760px) {
    .svc-grid { grid-template-columns: 1fr 1fr }
  }
</style>

<script>
  // Replace with your Formspree form ID from formspree.io
  const REHAB_FORMSPREE_ID = 'mlgodbkj';

  const rehabForm = document.getElementById('rehab-form-el') as HTMLFormElement | null;
  const rehabSubmit = document.getElementById('rehabSubmit') as HTMLButtonElement | null;
  const rehabErr = document.getElementById('rehabErr');
  const rehabSuccess = document.getElementById('rehabSuccess');
  const rehabMessage = document.getElementById('r-message') as HTMLTextAreaElement | null;

  // "Boka [tjänst] →" on each service card prefills the message with that service
  document.querySelectorAll('.svc-book').forEach(btn => {
    btn.addEventListener('click', () => {
      const service = (btn as HTMLElement).dataset.service;
      if (rehabMessage && service && !rehabMessage.value.includes(service)) rehabMessage.value += `Jag vill boka: ${service}\n`;
      document.getElementById('rehab-form')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      rehabMessage?.focus();
    });
  });

  rehabForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    rehabErr?.classList.remove('show');
    if (rehabSubmit) { rehabSubmit.disabled = true; rehabSubmit.textContent = 'Skickar…'; }
    try {
      const res = await fetch(`https://formspree.io/f/${REHAB_FORMSPREE_ID}`, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(rehabForm),
      });
      if (!res.ok) throw new Error('bad response');
      rehabForm.style.display = 'none';
      rehabSuccess?.classList.add('show');
    } catch (err) {
      rehabErr?.classList.add('show');
      if (rehabSubmit) { rehabSubmit.disabled = false; rehabSubmit.textContent = 'Boka Rehab →'; }
    }
  });
</script>
