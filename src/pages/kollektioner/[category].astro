---
import Layout from '../../layouts/Layout.astro';
import ModelGallery from '../../components/ModelGallery.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const categories = await getCollection('productCategories');
  return categories.map(c => ({
    params: { category: c.data.key },
    props: { category: c.data },
  }));
}

const { category } = Astro.props;
const isOther = category.key === 'ovrigt';
const vibe = category.key === 'cymbalstockar' ? 'amber' : category.key === 'ovrigt' ? 'violet' : 'blue';

const otherProducts = isOther
  ? (await getCollection('otherProducts')).sort((a, b) => a.data.order - b.data.order)
  : [];
---

<Layout title={category.nameSv} vibe={vibe}>
  <div class="page-hero" style="min-height:auto;padding-bottom:2rem">
    <div class="page-hero-inner">
      <h1 data-en={category.nameEn}>{category.nameSv}</h1>
      <p>{category.descSv}</p>
    </div>
  </div>

  <main>
    {isOther ? (
      <section class="section prods">
        <div class="section-inner prod-list">
          {otherProducts.map(p => {
            const imgs = p.data.images;
            const first = p.data.options[0];
            const price = first ? first.priceSek : p.data.priceSek;
            const model = first ? `${p.data.nameSv} (${first.label})` : p.data.nameSv;
            const onRequest = price === 0;
            return (
              <article class="prod">
                <div class:list={['prod-media', { 'prod-media--empty': !imgs.length }]}>
                  {imgs.length ? (
                    <div class="prod-track" data-track>
                      {imgs.map((src, i) => <img src={src} alt={`${p.data.nameSv}, bild ${i + 1} av ${imgs.length}`} loading="lazy" />)}
                    </div>
                  ) : (
                    <div class="prod-ph"><svg viewBox="-6 -6 298 314" aria-hidden="true"><polygon points="45,0 285,150 45,302 0,272 170,150 0,30" stroke-width="10" stroke-linejoin="round"/></svg></div>
                  )}
                  {imgs.length > 1 && (
                    <div class="prod-dots" aria-hidden="true">{imgs.map((_, i) => <i class:list={{ on: i === 0 }}></i>)}</div>
                  )}
                </div>
                <div class="prod-info">
                  <h2 class="prod-name" data-en={p.data.nameEn}>{p.data.nameSv}</h2>
                  <p class="prod-desc">{p.data.descSv}</p>
                  {p.data.options.length > 0 && (
                    <div class="prod-opts" role="radiogroup" aria-label={`Välj variant av ${p.data.nameSv}`}>
                      {p.data.options.map((o, i) => (
                        <button type="button" class="prod-opt" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-opt={o.label} data-price={o.priceSek}>{o.label}</button>
                      ))}
                    </div>
                  )}
                  <div class="prod-foot">
                    <span class="prod-price">
                      <span data-price-out>{onRequest ? 'Pris på förfrågan' : `${price.toLocaleString('sv-SE')} SEK`}</span>
                      {!onRequest && p.data.priceUnit && <small>{p.data.priceUnit}</small>}
                    </span>
                    {onRequest ? (
                      <button type="button" class="btn" data-order data-series="Övrigt" data-model={p.data.nameSv}>Fråga om pris →</button>
                    ) : (
                      <button
                        type="button"
                        class="btn"
                        data-add-cart
                        data-base-model={p.data.nameSv}
                        data-model={model}
                        data-key={`Övrigt||${model}`}
                        data-series="Övrigt"
                        data-price={price}
                        data-color={category.color}
                        data-image={imgs[0] || ''}
                      >Lägg i varukorg →</button>
                    )}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    ) : (
      <ModelGallery categoryKey={category.key} />
    )}

    <section class="ask">
      <div class="ask-inner">
        <p><b>Hittar du inte rätt?</b> Vi hjälper dig välja eller bygger något eget.</p>
        <button type="button" class="btn btn-ghost" data-order>Fråga oss →</button>
      </div>
    </section>
  </main>
</Layout>

<style>
  .ask { padding: 0 1.75rem 4.5rem }
  .ask-inner {
    max-width: var(--max); margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 1rem 1.5rem; flex-wrap: wrap;
    padding: 1.2rem 1.4rem; border: 1px solid var(--border2); border-radius: var(--r-sm); background: rgba(242,233,216,0.03);
  }
  .ask p { color: var(--text2); font-size: 0.92rem }
  .ask b { color: var(--cream); font-family: var(--font-display); font-weight: 800; margin-right: 0.3rem }
  @media (max-width: 767px) { .ask { padding-inline: 1.25rem } .ask .btn { width: 100%; justify-content: center } }

  .prods { padding-top: 0.5rem }
  .prod-list { display: grid; gap: 1rem }
  .prod { display: grid; grid-template-columns: 1fr; overflow: hidden; border: 1px solid var(--border2); border-radius: var(--r); background: var(--glass) }
  .prod-media { position: relative; aspect-ratio: 4 / 3; background: var(--dark3) }
  .prod-track { display: flex; height: 100%; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none }
  .prod-track::-webkit-scrollbar { display: none }
  .prod-track img { flex: 0 0 100%; width: 100%; height: 100%; object-fit: cover; scroll-snap-align: start }
  .prod-media--empty { aspect-ratio: 21 / 9 }
  .prod-ph { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center }
  .prod-ph svg { width: 14%; height: auto; opacity: 0.2 }
  .prod-ph polygon { fill: var(--cream); stroke: var(--cream) }
  .prod-dots { position: absolute; bottom: 0.8rem; left: 0; right: 0; display: flex; justify-content: center; gap: 6px; pointer-events: none }
  .prod-dots i { width: 7px; height: 7px; border-radius: 50%; background: rgba(242,233,216,0.4); transition: background 0.2s, transform 0.2s }
  .prod-dots i.on { background: var(--cream); transform: scale(1.2) }
  .prod-info { padding: 1.4rem; display: flex; flex-direction: column; gap: 0.6rem }
  .prod-name { font-family: var(--font-display); font-size: 1.6rem; font-weight: 900; letter-spacing: -0.035em; color: var(--cream); line-height: 1 }
  .prod-desc { color: var(--text2); line-height: 1.6; font-size: 0.92rem }
  .prod-foot { margin-top: auto; padding-top: 1rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; border-top: 1px solid var(--border2) }
  .prod-price { font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; color: var(--cream) }
  .prod-price small { font-family: var(--font-sans); font-weight: 400; font-size: 0.8rem; color: var(--text3); margin-left: 0.35rem }
  .prod-opts { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.3rem }
  .prod-opt {
    padding: 0.55rem 1rem; border-radius: 100px; cursor: pointer;
    border: 1px solid var(--border2); background: rgba(242,233,216,0.04); color: var(--cream2);
    font: 600 0.82rem var(--font-sans); transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .prod-opt[aria-checked="true"] { background: var(--cream); color: var(--dark); border-color: var(--cream) }
  .prod-opt:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px }
  @media (min-width: 820px) {
    .prod { grid-template-columns: 1.1fr 1fr }
    .prod-media { aspect-ratio: auto; min-height: 320px }
    .prod-media--empty { min-height: 220px }
    .prod-track { position: absolute; inset: 0 }
    .prod-info { padding: 2rem; justify-content: center }
  }
</style>

<script>
  // Keep the dots under each product's photo strip in sync with the swipe position
  document.querySelectorAll<HTMLElement>('.prod-media').forEach(media => {
    const track = media.querySelector<HTMLElement>('[data-track]');
    const dots = [...media.querySelectorAll<HTMLElement>('.prod-dots i')];
    if (!track || !dots.length) return;
    track.addEventListener('scroll', () => {
      const i = Math.round(track.scrollLeft / track.clientWidth);
      dots.forEach((d, j) => d.classList.toggle('on', j === i));
    }, { passive: true });
  });

  // Variant choice (e.g. 5 or 7 pairs) is carried into the cart line
  document.querySelectorAll<HTMLElement>('.prod').forEach(prod => {
    const opts = [...prod.querySelectorAll<HTMLElement>('.prod-opt')];
    const add = prod.querySelector<HTMLElement>('[data-add-cart]');
    const priceOut = prod.querySelector<HTMLElement>('[data-price-out]');
    if (!opts.length || !add) return;
    opts.forEach(o => o.addEventListener('click', () => {
      opts.forEach(x => x.setAttribute('aria-checked', String(x === o)));
      const model = `${add.dataset.baseModel} (${o.dataset.opt})`;
      add.dataset.model = model;
      add.dataset.key = `Övrigt||${model}`;
      add.dataset.price = o.dataset.price || '0';
      if (priceOut) priceOut.textContent = `${Number(o.dataset.price).toLocaleString('sv-SE')} SEK`;
    }));
  });
</script>
