---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const [entry] = await getCollection('craft');
const c = entry.data;
// Empty slots are only drawn while developing locally, never on the live site
const dev = import.meta.env.DEV;

// Turn any pasted video link into something embeddable
function resolveVideo(url: string) {
  if (!url) return null;
  const yt = url.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([\w-]{11})/);
  if (yt) return { type: 'iframe', src: `https://www.youtube-nocookie.com/embed/${yt[1]}?autoplay=1&rel=0` };
  const vimeo = url.match(/vimeo\.com\/(?:video\/)?(\d+)/);
  if (vimeo) return { type: 'iframe', src: `https://player.vimeo.com/video/${vimeo[1]}?autoplay=1` };
  if (/\.(mp4|webm|mov)(\?.*)?$/i.test(url)) return { type: 'video', src: url };
  return { type: 'iframe', src: url };
}
const video = resolveVideo(c.videoUrl);
const photos = c.photos;

function withAccent(text: string, accent: string) {
  const i = accent ? text.toLowerCase().indexOf(accent.toLowerCase()) : -1;
  if (i === -1) return [{ t: text, hl: false }];
  return [
    { t: text.slice(0, i), hl: false },
    { t: text.slice(i, i + accent.length), hl: true },
    { t: text.slice(i + accent.length), hl: false },
  ].filter(p => p.t.length);
}
const headParts = withAccent(c.heading, c.accent);
---

<Layout title="Tillverkningen" vibe="amber">
  <div class="page-hero" style="min-height:auto;padding-bottom:1.5rem">
    <div class="page-hero-inner">
      <h1>{headParts.map(p => p.hl ? <em>{p.t}</em> : p.t)}</h1>
      {c.lead && <p>{c.lead}</p>}
    </div>
  </div>

  <main>
    {(video || dev) && (
      <section class="film-sec">
        {video ? (
          <div class="film" data-type={video.type} data-src={video.src}>
            {c.videoPoster && <img class="film-poster" src={c.videoPoster} alt="" loading="eager" />}
            <button type="button" class="film-play" aria-label="Spela filmen">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l13-7.5z" /></svg>
            </button>
          </div>
        ) : (
          <div class="film film--empty">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l13-7.5z" /></svg>
            <b>Plats för film</b>
            <span>Ca 45 sekunder. Lägg in länken i CMS:et under Tillverkningen.</span>
          </div>
        )}
      </section>
    )}

    {(photos.length > 0 || dev) && (
      <section class="photos-sec">
        <div class="photos">
          {photos.length > 0
            ? photos.map((p, i) => (
                <button type="button" class="ph" data-i={i} aria-label={p.caption ? `Visa bild: ${p.caption}` : `Visa bild ${i + 1} av ${photos.length}`}>
                  <img src={p.image} alt={p.caption || `Från verkstaden, bild ${i + 1}`} loading={i < 3 ? 'eager' : 'lazy'} />
                </button>
              ))
            : Array.from({ length: 9 }, (_, i) => (
                <div class="ph ph--empty">{i === 0 && <span>Plats för bilder från verkstaden</span>}</div>
              ))}
        </div>
      </section>
    )}

    {photos.length > 0 && (
      <div class="lb" role="dialog" aria-modal="true" aria-label="Bilder från verkstaden" hidden>
        <div class="lb-top">
          <button type="button" class="lb-btn" data-lb-close aria-label="Stäng">×</button>
          <span class="lb-pos"><span data-lb-idx>1</span> / {photos.length}</span>
        </div>
        <div class="lb-track" data-lb-track>
          {photos.map((p, i) => (
            <figure class="lb-slide">
              <img src={p.image} alt={p.caption || `Från verkstaden, bild ${i + 1}`} loading="lazy" />
              {p.caption && <figcaption>{p.caption}</figcaption>}
            </figure>
          ))}
        </div>
        <button type="button" class="lb-btn lb-arrow lb-arrow--prev" data-lb-go="-1" aria-label="Föregående bild">←</button>
        <button type="button" class="lb-btn lb-arrow lb-arrow--next" data-lb-go="1" aria-label="Nästa bild">→</button>
      </div>
    )}
  </main>
</Layout>

<style>
  .lb[hidden] { display: none !important }

  /* ── Film ── */
  .film-sec { padding: 0.5rem 1.75rem 1rem }
  .film {
    position: relative; max-width: var(--max); margin: 0 auto; aspect-ratio: 16 / 9;
    border-radius: var(--r); overflow: hidden; background: var(--dark3);
  }
  .film-poster { width: 100%; height: 100%; object-fit: cover; display: block }
  .film-play {
    position: absolute; inset: 0; margin: auto; width: clamp(64px, 9vw, 92px); height: clamp(64px, 9vw, 92px);
    border-radius: 50%; border: 0; cursor: pointer; background: var(--cream); color: var(--dark);
    display: grid; place-items: center; box-shadow: 0 6px 24px rgba(0,0,0,0.45); transition: transform 0.25s var(--ease);
  }
  .film:hover .film-play { transform: scale(1.06) }
  .film-play:focus-visible { outline: 2px solid var(--blue); outline-offset: 4px }
  .film-play svg { width: 38%; height: 38%; margin-left: 6%; fill: currentColor }
  .film iframe, .film video { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; display: block; background: #000 }
  .film--empty {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.4rem; text-align: center; padding: 1rem;
    border: 1.5px dashed rgba(242,233,216,0.25); background: rgba(242,233,216,0.03); color: var(--text3); font-size: 0.85rem;
  }
  .film--empty svg { width: 40px; height: 40px; fill: var(--text3) }
  .film--empty b { font-family: var(--font-display); font-weight: 800; font-size: 1.15rem; color: var(--cream) }

  /* ── Workshop photos ── */
  .photos-sec { padding: 0.5rem 1.75rem 4.5rem }
  .photos { max-width: var(--max); margin: 0 auto; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; grid-auto-flow: dense }
  .ph {
    display: block; padding: 0; border: 0; cursor: zoom-in; overflow: hidden;
    aspect-ratio: 1 / 1; border-radius: var(--r-sm); background: var(--dark3);
  }
  .ph:first-child { grid-column: span 2; aspect-ratio: 4 / 3 }
  .ph img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s var(--ease) }
  .ph:hover img { transform: scale(1.04) }
  .ph:focus-visible { outline: 2px solid var(--blue); outline-offset: 3px }
  .ph--empty {
    cursor: default; display: flex; align-items: center; justify-content: center; text-align: center; padding: 1rem;
    border: 1.5px dashed rgba(242,233,216,0.2); background: rgba(242,233,216,0.03);
    font-family: var(--font-display); font-weight: 800; font-size: 1rem; color: var(--cream2);
  }

  /* ── Lightbox ── */
  .lb { position: fixed; inset: 0; z-index: 360; background: rgba(6,9,13,0.97); display: flex; flex-direction: column }
  .lb-top { display: flex; align-items: center; justify-content: space-between; padding: calc(env(safe-area-inset-top, 0px) + 0.9rem) 1rem 0.6rem }
  .lb-btn {
    background: rgba(11,19,28,0.78); border: 1px solid rgba(242,233,216,0.16); color: var(--cream); cursor: pointer;
    width: 44px; height: 44px; border-radius: 50%; font-size: 1.4rem; line-height: 1; display: grid; place-items: center;
  }
  .lb-pos { padding: 0.5rem 0.95rem; border-radius: 100px; border: 1px solid rgba(242,233,216,0.16); background: rgba(11,19,28,0.78); color: var(--cream); font-size: 0.76rem; letter-spacing: 0.08em; font-variant-numeric: tabular-nums }
  .lb-track { flex: 1; display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior: contain }
  .lb-track::-webkit-scrollbar { display: none }
  .lb-slide {
    flex: 0 0 100%; scroll-snap-align: start; scroll-snap-stop: always; margin: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.9rem;
    padding: 0 1rem calc(env(safe-area-inset-bottom, 0px) + 1.5rem);
  }
  .lb-slide img { max-width: 100%; max-height: 78svh; object-fit: contain; border-radius: var(--r-sm) }
  .lb-slide figcaption { color: var(--text2); font-size: 0.92rem; text-align: center; max-width: 48ch }
  .lb-arrow { display: none }

  @media (min-width: 820px) {
    .photos { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.8rem }
    .ph:first-child { grid-column: span 2; grid-row: span 2; aspect-ratio: auto }
    .lb-arrow { display: grid; position: absolute; top: 50%; margin-top: -22px }
    .lb-arrow:disabled { opacity: 0.25; cursor: default }
    .lb-arrow--prev { left: 1.2rem }
    .lb-arrow--next { right: 1.2rem }
  }
  @media (max-width: 767px) { .film-sec, .photos-sec { padding-inline: 1.25rem } }
  @media (prefers-reduced-motion: reduce) { .ph img, .film-play { transition: none } }
</style>

<script>
  // Click-to-play: the player only loads when someone actually wants to watch
  document.querySelector<HTMLButtonElement>('.film-play')?.addEventListener('click', e => {
    const film = (e.currentTarget as HTMLElement).closest<HTMLElement>('.film');
    const src = film?.dataset.src;
    if (!film || !src) return;
    let player: HTMLElement;
    if (film.dataset.type === 'video') {
      const v = document.createElement('video');
      v.src = src; v.controls = true; v.autoplay = true; v.playsInline = true;
      player = v;
    } else {
      const f = document.createElement('iframe');
      f.src = src; f.title = 'Film från verkstaden';
      f.allow = 'autoplay; fullscreen; picture-in-picture';
      f.setAttribute('allowfullscreen', '');
      player = f;
    }
    film.replaceChildren(player);
  });

  const lb = document.querySelector<HTMLElement>('.lb');
  if (lb) {
    const track = lb.querySelector<HTMLElement>('[data-lb-track]')!;
    const idxEl = lb.querySelector<HTMLElement>('[data-lb-idx]')!;
    const prev = lb.querySelector<HTMLButtonElement>('[data-lb-go="-1"]')!;
    const next = lb.querySelector<HTMLButtonElement>('[data-lb-go="1"]')!;
    const count = track.children.length;
    let lastTrigger: HTMLElement | null = null;

    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const sync = () => {
      const i = current();
      idxEl.textContent = String(i + 1);
      prev.disabled = i <= 0;
      next.disabled = i >= count - 1;
    };
    const go = (i: number) => track.scrollTo({ left: Math.max(0, Math.min(count - 1, i)) * track.clientWidth, behavior: 'smooth' });
    const open = (i: number) => {
      lb.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      track.scrollLeft = i * track.clientWidth;
      sync();
      lb.querySelector<HTMLElement>('[data-lb-close]')!.focus({ preventScroll: true });
    };
    const close = () => {
      lb.hidden = true;
      document.documentElement.style.overflow = '';
      lastTrigger?.focus({ preventScroll: true });
    };

    document.querySelectorAll<HTMLElement>('.ph[data-i]').forEach(btn => btn.addEventListener('click', () => {
      lastTrigger = btn;
      open(Number(btn.dataset.i));
    }));
    track.addEventListener('scroll', sync, { passive: true });
    lb.querySelector('[data-lb-close]')!.addEventListener('click', close);
    prev.addEventListener('click', () => go(current() - 1));
    next.addEventListener('click', () => go(current() + 1));
    document.addEventListener('keydown', e => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowRight') go(current() + 1);
      if (e.key === 'ArrowLeft') go(current() - 1);
    });
  }
</script>
