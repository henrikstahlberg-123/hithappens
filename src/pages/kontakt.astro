---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const [siteEntry] = await getCollection('settings');
const site = siteEntry.data;

const fields = [
  { id: 'c-name', name: 'name', label: 'Namn', type: 'text', placeholder: 'För- och efternamn', autocomplete: 'name' },
  { id: 'c-email', name: 'email', label: 'E-postadress', type: 'email', placeholder: 'din@email.se', autocomplete: 'email' },
];
---

<Layout title="Kontakt">
  <div class="page-hero" style="min-height:auto;padding-bottom:1.5rem">
    <div class="page-hero-inner">
      <h1>Hör av <em>dig</em></h1>
      <p>Frågor om beställningar, mått, material eller leverans. Vi svarar inom 24 timmar.</p>
    </div>
  </div>

  <main>
    <section class="section contact">
      <div class="section-inner contact-grid">
        <div class="contact-links">
          <a href={`mailto:${site.email}`} class="contact-line">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/></svg>
            <span><span class="contact-k">E-post</span><span class="contact-v">{site.email}</span></span>
          </a>
          <a href={`https://www.instagram.com/${site.instagramHandle}`} target="_blank" rel="noopener" class="contact-line">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="0.6" fill="currentColor"/></svg>
            <span><span class="contact-k">Instagram</span><span class="contact-v">@{site.instagramHandle}</span></span>
          </a>
        </div>

        <div class="glass glass-grad lit contact-card">
          <form id="contactForm">
            <input type="hidden" name="_subject" value="Meddelande från hithappens.se" />
            <div class="cf-row">
              {fields.map(field => (
                <div class="cf-field">
                  <label for={field.id}>{field.label}</label>
                  <input type={field.type} id={field.id} name={field.name} placeholder={field.placeholder} autocomplete={field.autocomplete} required />
                </div>
              ))}
            </div>
            <div class="cf-field">
              <label for="c-message">Meddelande</label>
              <textarea id="c-message" name="message" rows="4" placeholder="Skriv ditt meddelande här…" required></textarea>
            </div>
            <button type="submit" class="btn" id="contactSubmit" style="width:100%;justify-content:center">Skicka meddelande →</button>
            <p class="order-err" id="contactErr">Något gick fel. Försök igen eller mejla oss direkt.</p>
          </form>
          <div class="order-success" id="contactSuccess">
            <div class="tick">✓</div>
            <h2>Tack!</h2>
            <p class="order-intro">Vi har tagit emot ditt meddelande och återkommer inom 24 timmar.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .contact { padding-top: 0.5rem }
  .contact-grid { display: grid; grid-template-columns: 1fr; gap: 0.8rem }
  .contact-links { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.6rem; align-content: start }
  .contact-line {
    display: flex; align-items: center; gap: 0.9rem; padding: 0.75rem 1rem; min-width: 0;
    border: 1px solid var(--border2); border-radius: var(--r-sm); background: rgba(242,233,216,0.03);
    text-decoration: none; transition: border-color 0.2s, background 0.2s;
  }
  .contact-line:hover { border-color: rgba(242,233,216,0.25); background: rgba(242,233,216,0.06) }
  .contact-line svg { width: 22px; height: 22px; flex-shrink: 0; fill: none; stroke: var(--page); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round }
  .contact-line > span { min-width: 0 }
  .contact-k { font-size: 0.62rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text3); display: block; font-weight: 600 }
  .contact-v { font-size: 0.92rem; color: var(--cream); display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap }
  .contact-card { padding: 1.25rem }

  .cf-row { display: grid; grid-template-columns: 1fr; column-gap: 0.8rem }
  .cf-field { margin-bottom: 0.85rem }
  .cf-field label { display: block; font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600; color: var(--text2); margin-bottom: 0.4rem }
  .cf-field input, .cf-field textarea {
    width: 100%; padding: 0.75rem 0.9rem; background: rgba(11,19,28,0.6);
    border: 1px solid var(--border2); border-radius: var(--r-sm); color: var(--cream);
    font-family: var(--font-sans); font-size: 0.95rem; transition: border-color 0.2s, box-shadow 0.2s; resize: vertical;
  }
  .cf-field input::placeholder, .cf-field textarea::placeholder { color: var(--text3) }
  .cf-field input:focus, .cf-field textarea:focus { outline: none; border-color: rgba(74,158,255,0.6); box-shadow: 0 0 0 3px rgba(74,158,255,0.12) }
  .btn[disabled] { opacity: 0.6; cursor: wait }

  @media (min-width: 520px) { .cf-row { grid-template-columns: 1fr 1fr } }
  @media (min-width: 900px) {
    .contact-grid { grid-template-columns: 1fr 1.6fr; gap: 1.5rem; align-items: start }
    .contact-links { grid-template-columns: 1fr }
    .contact-card { padding: 2rem }
  }
</style>

<script>
  // Replace with your Formspree form ID from formspree.io
  const CONTACT_FORMSPREE_ID = 'mlgodbkj';

  const contactForm = document.getElementById('contactForm') as HTMLFormElement | null;
  const contactSubmit = document.getElementById('contactSubmit') as HTMLButtonElement | null;
  const contactErr = document.getElementById('contactErr');
  const contactSuccess = document.getElementById('contactSuccess');

  contactForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    contactErr?.classList.remove('show');
    if (contactSubmit) { contactSubmit.disabled = true; contactSubmit.textContent = 'Skickar…'; }
    try {
      const res = await fetch(`https://formspree.io/f/${CONTACT_FORMSPREE_ID}`, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(contactForm),
      });
      if (!res.ok) throw new Error('bad response');
      contactForm.style.display = 'none';
      contactSuccess?.classList.add('show');
    } catch (err) {
      contactErr?.classList.add('show');
      if (contactSubmit) { contactSubmit.disabled = false; contactSubmit.textContent = 'Skicka meddelande →'; }
    }
  });
</script>
