---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const merch = (await getCollection('merch')).sort((a, b) => a.data.num.localeCompare(b.data.num));
const [siteEntry] = await getCollection('settings');
const site = siteEntry.data;

const freeLabel = (n?: number) =>
  n === undefined ? '' : n === 0 ? 'Ingår gratis i alla beställningar' : `Gratis vid fler än ${n} par`;
---

<Layout title="Merch" vibe="green">
  <div class="page-hero" style="min-height:auto;padding-bottom:1.5rem">
    <div class="page-hero-inner">
      <h1>Bär <em>märket</em></h1>
      <p>Keps, tygpåse och stickers. Vill du ha flera saker? Skriv alla i samma beställning.</p>
    </div>
  </div>

  <main>
    <section class="section merch-sec">
      <div class="section-inner merch-grid">
        {merch.map(item => (
          <article class="glass merch">
            <div class="merch-img">
              {item.data.image ? (
                <img src={item.data.image} alt={item.data.nameSv} loading="lazy" />
              ) : (
                <svg class="merch-ph" viewBox="-6 -6 298 314" aria-hidden="true"><polygon points="45,0 285,150 45,302 0,272 170,150 0,30" stroke-width="10" stroke-linejoin="round"/></svg>
              )}
            </div>
            <div class="merch-info">
              <div class="merch-top">
                <h2 class="merch-name">{item.data.nameSv}</h2>
                <span class="merch-price">{item.data.priceSek.toLocaleString('sv-SE')} SEK</span>
              </div>
              <p class="merch-desc">{item.data.descSv}</p>
              {freeLabel(item.data.freeFromPairs) && <p class="merch-free">{freeLabel(item.data.freeFromPairs)}</p>}
              <a href={`mailto:${site.email}?subject=Merch-beställning: ${item.data.nameSv}`} class="merch-buy">Beställ <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>

<style>
  .merch-sec { padding-top: 0.5rem }
  .merch-grid { display: grid; grid-template-columns: 1fr; gap: 0.8rem }
  .merch { display: grid; grid-template-columns: 104px 1fr; gap: 1rem; padding: 0.8rem; align-items: center }
  .merch-img {
    aspect-ratio: 1 / 1; border-radius: var(--r-sm); overflow: hidden; background: var(--dark3);
    display: flex; align-items: center; justify-content: center;
  }
  .merch-img img { width: 100%; height: 100%; object-fit: cover; display: block }
  .merch-ph { width: 30%; height: auto; opacity: 0.22 }
  .merch-ph polygon { fill: var(--cream); stroke: var(--cream) }
  .merch-info { min-width: 0; display: flex; flex-direction: column; gap: 0.3rem }
  .merch-top { display: flex; align-items: baseline; justify-content: space-between; gap: 0.8rem }
  .merch-name { font-family: var(--font-display); font-size: 1.15rem; font-weight: 800; color: var(--cream); line-height: 1.1; letter-spacing: -0.02em }
  .merch-price { font-family: var(--font-display); font-weight: 700; font-size: 0.95rem; color: var(--cream); white-space: nowrap }
  .merch-desc { font-size: 0.86rem; color: var(--text2); line-height: 1.5 }
  .merch-free { font-size: 0.72rem; color: var(--warm2); font-weight: 600 }
  .merch-free::before { content: '✓ ' }
  .merch-buy {
    align-self: flex-start; margin-top: 0.3rem; text-decoration: none;
    font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600; color: var(--page);
  }
  .merch-buy span { display: inline-block; transition: transform 0.2s var(--ease) }
  .merch-buy:hover span { transform: translateX(3px) }

  @media (min-width: 700px) { .merch-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem } }
  @media (min-width: 1060px) {
    .merch-grid { grid-template-columns: repeat(3, minmax(0, 1fr)) }
    .merch { grid-template-columns: 120px 1fr; align-items: start }
  }
</style>
