---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allCategories = await getCollection('productCategories');
const categories = allCategories.sort((a, b) => a.data.order - b.data.order);

const allSeries = await getCollection('series');
const allOtherProducts = await getCollection('otherProducts');
const countByCategory = (key: string) => key === 'ovrigt'
  ? allOtherProducts.length
  : allSeries.filter(s => s.data.category === key).length;
const labelByCategory = (key: string, n: number) => key === 'ovrigt'
  ? (n === 1 ? 'produkt' : 'produkter')
  : (n === 1 ? 'serie' : 'serier');
---

<Layout title="Produkter">
  <div class="page-hero">
    <div class="page-hero-inner">
      <p class="page-kicker">Produkterna</p>
      <h1>Välj <em>kategori</em></h1>
      <p>Pukstockar, cymbalstockar eller tillbehör — välj kategori för att se allt.</p>
    </div>
  </div>

  <main>
    <section class="section">
      <div class="section-inner">
        <div class="cat-grid">
          {categories.map(c => (
            <a href={`/kollektioner/${c.data.key}`} class="glass glass-grad cat-card lit reveal" style={`--c:${c.data.color}`}>
              <span class="cat-name" data-en={c.data.nameEn}>{c.data.nameSv}</span>
              <p class="cat-desc">{c.data.descSv}</p>
              <div class="cat-foot">
                <span>{countByCategory(c.data.key)} {labelByCategory(c.data.key, countByCategory(c.data.key))}</span>
                <span class="cat-go">→</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem }
  .cat-card {
    position: relative; overflow: hidden; padding: 2.2rem;
    text-decoration: none; display: flex; flex-direction: column;
    transition: transform 0.3s var(--ease), border-color 0.3s, box-shadow 0.35s;
  }
  .cat-card::after {
    content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    background: radial-gradient(ellipse 70% 80% at 85% 110%, color-mix(in srgb, var(--c) 35%, transparent), transparent 60%);
    opacity: 0.5; transition: opacity 0.35s;
  }
  .cat-card:hover {
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--c) 60%, transparent);
    box-shadow: 0 1px 0 rgba(255,255,255,0.06) inset, 0 22px 60px rgba(0,0,0,0.55), 0 0 70px color-mix(in srgb, var(--c) 28%, transparent);
  }
  .cat-card:hover::after { opacity: 1 }
  .cat-name { font-family: var(--font-serif); font-size: 2rem; font-weight: 400; color: var(--cream); margin-bottom: 0.6rem; position: relative; z-index: 1 }
  .cat-desc { font-size: 0.9rem; color: var(--text2); line-height: 1.7; font-weight: 300; position: relative; z-index: 1 }
  .cat-foot {
    position: relative; z-index: 1; margin-top: 1.5rem; padding-top: 1rem;
    display: flex; align-items: center; justify-content: space-between;
    font-size: 0.72rem; color: var(--text3); letter-spacing: 0.04em;
    border-top: 1px solid var(--border2);
  }
  .cat-go {
    width: 30px; height: 30px; border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--c) 45%, transparent);
    display: flex; align-items: center; justify-content: center;
    color: var(--c); filter: brightness(1.3); font-size: 0.85rem;
    transition: background 0.3s, transform 0.3s var(--ease), color 0.3s;
  }
  .cat-card:hover .cat-go { background: var(--c); color: #0b131c; transform: translateX(3px); filter: none }
</style>
